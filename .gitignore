# ====================================================================
# Multilingual Ticket Translator - Master .gitignore
# ====================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables and Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
bin/
nbproject/
*.sublime-project
*.sublime-workspace

# --------------------------------------------------------------------
# Backend (Java / Maven)
# --------------------------------------------------------------------
backend/target/
backend/*.jar
backend/*.war
backend/*.nar
backend/*.ear
backend/*.zip
backend/*.tar.gz
backend/*.rar
backend/**/.mvn/wrapper/maven-wrapper.jar

# --------------------------------------------------------------------
# Frontend (Node / React / Vite)
# --------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/coverage/

# Logs and Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
*.swp
*~
